# Nothing here is required on Vercel: the Neon store sets DATABASE_URL and the
# app generates its own secrets (docs/ENVIRONMENT.md). Set real values in
# Vercel or a gitignored .env.local, never in git.
# DATABASE_URL is used exactly as configured: for local dev, point it at a
# database of its own, never one with real data. See docs/ENVIRONMENT.md
# ("Running the app locally") before running `npm run dev`.
DATABASE_URL=
# Left empty, SESSION_SECRET, SYNC_TOKEN, OAUTH_SIGNING_SECRET and
# INTEGRATION_ENCRYPTION_KEY are generated and stored in the database.
SESSION_SECRET=
# Optional separate signing key for MCP OAuth access tokens. If unset,
# SESSION_SECRET is used.
OAUTH_SIGNING_SECRET=
# Dedicated key for encrypting integration credentials (GitHub tokens) at rest:
# 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotation (keep retired keys here until tokens are resealed) -- see docs/ENVIRONMENT.md.
INTEGRATION_ENCRYPTION_KEY=
INTEGRATION_ENCRYPTION_KEYS_PREVIOUS=
SYNC_TOKEN=

# Optional: lets Vercel Cron run the daily retention purge. Without it the
# app runs the purge itself, at most once a day.
CRON_SECRET=

# Set to 1 only to reopen first-run setup (a forgotten password, or taking
# this Cardlake back), then remove it again (docs/ADMIN.md).
CARDLE_SETUP_OPEN=

# This deployment's address, for a custom domain. Defaults to the Vercel
# project's production domain.
CARDLE_PUBLIC_ORIGIN=

# Optional legacy bearer token for /api/mcp, scoped to the shared 'default'
# account. The owner connects their own assistants from "Connect AI" instead.
MCP_TOKEN=

# Usage limits. Values are server-enforced; byte values use binary units
# (1 MiB = 1,048,576 bytes). Defaults are shown here, so these can be left
# unset until you need different limits.
CARDLE_MAX_CARDS_PER_USER=500
CARDLE_MAX_TEXT_BYTES_PER_USER=2097152
CARDLE_MAX_ATTACHMENTS_PER_CARD=5
CARDLE_MAX_FILE_BYTES=4194304
CARDLE_MAX_FILE_BYTES_PER_USER=52428800
CARDLE_MAX_UPLOADS_PER_DAY=20
CARDLE_MAX_FILENAME_CHARS=128
CARDLE_MAX_TITLE_CHARS=200
CARDLE_MAX_CONTENT_CHARS=50000
CARDLE_MAX_URL_CHARS=2048
CARDLE_MAX_WORK_ITEMS=100
CARDLE_MAX_JSON_BODY_BYTES=262144

# Vercel Blob guardrails for this deployment. The alert threshold adds a
# warning to successful uploads; the hard threshold temporarily stops new
# uploads.
CARDLE_BLOB_STORAGE_ALERT_BYTES=21474836480
CARDLE_BLOB_STORAGE_HARD_LIMIT_BYTES=32212254720


# Optional local script settings.
# LOCAL_DEV_PG=1  # isolates local dev on a real local Postgres instead of Neon's HTTP driver -- see docs/ENVIRONMENT.md
# VAULT_SOURCE=
# VAULT_TARGET=
# API_BASE_URL=
# VERCEL_TOKEN=
# VERCEL_SCOPE=
